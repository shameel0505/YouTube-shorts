# ── Gemini (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── GCP project
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCS_BUCKET=your-shorts-bot-bucket

# ── Path to GCP service account JSON (for TTS + Storage)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ── YouTube OAuth (see README for how to generate)
YOUTUBE_CLIENT_SECRET_JSON=./client_secret.json
YOUTUBE_TOKEN_FILE=./token.json

# ── Pexels free API: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# ── Content
NICHE=AI and technology facts
SHORTS_PER_DAY=1
VIDEO_DURATION_SEC=55

# ── TTS voice options:
#   Male:   en-US-Neural2-D (default), en-US-Neural2-J
#   Female: en-US-Neural2-F, en-US-Neural2-H
TTS_VOICE_NAME=en-US-Neural2-D
TTS_SPEAKING_RATE=1.05

# ── Upload privacy: public | private | unlisted
YT_PRIVACY=public

# ── Optional: path to a royalty-free MP3 for background music (leave blank to skip)
BACKGROUND_MUSIC_PATH=
